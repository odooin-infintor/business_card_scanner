    <record id="bc_mapping_lead_city" model="business.card.field.mapping">
        <field name="template_id" ref="business_card_template_lead_default"/>
        <field name="sequence">70</field>
        <field name="card_field">city</field>
        <field name="lead_field">city</field>
    </record>
    <record id="bc_mapping_lead_zip" model="business.card.field.mapping">
        <field name="template_id" ref="business_card_template_lead_default"/>
        <field name="sequence">80</field>
        <field name="card_field">zip_code</field>
        <field name="lead_field">zip</field>
    </record>

</odoo>