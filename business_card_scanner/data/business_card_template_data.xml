    <record id="bc_mapping_lead_phone" model="business.card.field.mapping">
        <field name="template_id" ref="business_card_template_lead_default"/>
        <field name="sequence">40</field>
        <field name="card_field">phone</field>
        <field name="lead_field">phone</field>
    </record>
    <record id="bc_mapping_lead_mobile" model="business.card.field.mapping">
