<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         List View — Reference | Customer Name | Status | Model
    ================================================================ -->
    <record id="view_business_card_contact_list" model="ir.ui.view">
        <field name="name">business.card.contact.list</field>
        <field name="model">business.card.contact</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Business Card Feed"
                  decoration-muted="state == 'moved'"
                  decoration-info="state == 'pending'">
                <field name="name"         string="Reference"/>
                <field name="contact_name" string="Customer Name"/>
                <field name="state"
                       string="Status"
                       widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'moved'"/>
                <field name="model_type"   string="Model"/>
                <field name="create_date"  string="Created On"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Form View
    ================================================================ -->
    <record id="view_business_card_contact_form" model="ir.ui.view">
        <field name="name">business.card.contact.form</field>
        <field name="model">business.card.contact</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Business Card Contact">
                <header>
                    <button name="action_move_to_contacts"
                            string="Move to Contacts"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'moved'"/>
                    <button name="action_view_contact"
                            string="View Contact"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'pending'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,moved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="Moved to Contacts"
                            bg_color="bg-success"
                            invisible="state == 'pending'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="contact_name"
                                   string="Customer Name"
                                   readonly="state == 'moved'"/>
                            <field name="create_date"
                                   string="Created on"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="model_type"
                                   string="Model"
                                   readonly="state == 'moved'"/>
                            <field name="partner_id"
                                   string="Partner Id"
                                   readonly="1"/>
                        </group>
                    </group>

                    <group string="Data">
                        <field name="raw_text"
                               nolabel="1"
                               readonly="1"
                               widget="text"/>
                    </group>

                    <notebook>
                        <page string="Contact Details" name="contact_details">
                            <group>
                                <group string="Identity">
                                    <field name="job_title"    readonly="state == 'moved'"/>
                                    <field name="company_name" readonly="state == 'moved'"/>
                                </group>
                                <group string="Contact">
                                    <field name="email"   widget="email" readonly="state == 'moved'"/>
                                    <field name="phone"   widget="phone" readonly="state == 'moved'"/>
                                    <field name="mobile"  widget="phone" readonly="state == 'moved'"/>
                                    <field name="website" widget="url"   readonly="state == 'moved'"/>
                                </group>
                            </group>
                            <group string="Address">
                                <field name="street"     readonly="state == 'moved'"/>
                                <field name="city"       readonly="state == 'moved'"/>
                                <field name="zip_code"   readonly="state == 'moved'"/>
                                <field name="state_id"   readonly="state == 'moved'"/>
                                <field name="country_id" readonly="state == 'moved'"/>
                            </group>
                        </page>
                        <page string="Card Image" name="card_image">
                            <field name="card_image"
                                   widget="image"
                                   options="{'size': [600, 400]}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Search View
    ================================================================ -->

