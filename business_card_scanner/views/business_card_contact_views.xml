    <record id="view_business_card_contact_search" model="ir.ui.view">
        <field name="name">business.card.contact.search</field>
        <field name="model">business.card.contact</field>
        <field name="arch" type="xml">
            <search string="Search Business Card Feed">
                <field name="name" string="Reference"/>
                <field name="contact_name" string="Contact Name"/>
                <field name="company_name" string="Company"/>
                <field name="email" string="Email"/>
                <field name="phone" string="Phone"/>

                <filter string="Pending Review"
                        name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Moved to Contacts"
                        name="filter_moved"
                        domain="[('state', '=', 'moved')]"/>
                <filter string="Partner"
                        name="filter_partner"
                        domain="[('model_type', '=', 'partner')]"/>
                <filter string="Lead"
                        name="filter_lead"
                        domain="[('model_type', '=', 'lead')]"/>

                <separator/>

                <filter string="Status"
                        name="groupby_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Model"
                        name="groupby_model_type"
                        context="{'group_by': 'model_type'}"/>
                <filter string="Company"
                        name="groupby_company_name"
                        context="{'group_by': 'company_name'}"/>
                <filter string="Source"
                        name="groupby_scan_source"
                        context="{'group_by': 'scan_source'}"/>
                <filter string="Date"
                        name="groupby_create_date"
                        context="{'group_by': 'create_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ================================================================
         Action — explicit view_ids force Odoo to always use our
         custom list and form views, never the auto-generated fallback
         that renders raw chatter tables.
    ================================================================ -->
    <record id="action_business_card_contacts" model="ir.actions.act_window">
        <field name="name">Business Card Feed</field>
        <field name="res_model">business.card.contact</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_business_card_contact_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_business_card_contact_form')}),
        ]"/>
        <field name="search_view_id" ref="view_business_card_contact_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Business Card Contacts yet!
            </p>
            <p>
                Scan a business card first. Scanned contacts appear here
                for review before being moved to main Contacts.
            </p>
        </field>
    </record>

</odoo>