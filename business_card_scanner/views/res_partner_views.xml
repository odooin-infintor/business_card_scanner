<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit res.partner form view to add two smart buttons:
        1. "Scan Card"  — opens the scanner wizard as a popup dialog (target=new)
        2. "Card Feed"  — opens linked business.card.contact records (only visible if count > 0)

        KEY FIX: The scanner action uses target="new" in the Python method, so it
        always opens as a dialog and never renders as a background/inline view.
    -->
    <record id="view_partner_form_bcs" model="ir.ui.view">
        <field name="name">res.partner.form.bcs</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">

                <!-- Button 1: Open Business Card Scanner wizard as a popup -->
                <button name="action_open_business_card_scanner"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-id-card">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Scan Card</span>
                    </div>
                </button>

                <!-- Button 2: View linked Business Card Feed records (hidden if none) -->
                <button name="action_view_business_card_feed"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-address-card"
                        invisible="business_card_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="business_card_count"/>
                        </span>
                        <span class="o_stat_text">Card Feed</span>
                    </div>
                </button>

            </xpath>
        </field>
    </record>
</odoo>