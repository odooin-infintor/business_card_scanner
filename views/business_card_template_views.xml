<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Business Card Template — Form View
    ================================================================ -->
    <record id="view_business_card_template_form" model="ir.ui.view">
        <field name="name">business.card.template.form</field>
        <field name="model">business.card.template</field>
        <field name="arch" type="xml">
            <form string="Business Card Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Business Card Template"/>
                        </h1>
                    </div>

                    <group string="Business Card Template Configuration">
                        <group>
                            <field name="target_model" string="Model"/>
                            <field name="auto_evaluate"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Field Mapping">
                            <p class="text-muted mb-2">
                                Map each extracted card field to the corresponding
                                field in the target model.
                            </p>
                            <field name="mapping_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="card_field"/>
                                    <field name="partner_field"
                                           attrs="{'column_invisible': [('parent.target_model', '!=', 'partner')]}"
                                           placeholder="e.g. name, function, email"/>
                                    <field name="lead_field"
                                           attrs="{'column_invisible': [('parent.target_model', '!=', 'lead')]}"
                                           placeholder="e.g. contact_name, job_position, email_from"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Business Card Template — List View
    ================================================================ -->
    <record id="view_business_card_template_list" model="ir.ui.view">
        <field name="name">business.card.template.list</field>
        <field name="model">business.card.template</field>
        <field name="arch" type="xml">
            <list string="Business Card Templates">
                <field name="name"/>
                <field name="target_model"
                       widget="badge"
                       decoration-info="target_model == 'lead'"
                       decoration-success="target_model == 'partner'"/>
                <field name="auto_evaluate"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Business Card Template — Action
    ================================================================ -->
    <record id="action_business_card_template" model="ir.actions.act_window">
        <field name="name">Business Card Template</field>
        <field name="res_model">business.card.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No templates yet!
            </p>
            <p>
                Create a template to configure whether scanned cards are saved
                as Partners or CRM Leads, and map card fields to Odoo fields.
            </p>
        </field>
    </record>

</odoo>