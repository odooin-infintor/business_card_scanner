<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Top-level App Menu
    ================================================================ -->
    <menuitem id="menu_business_card_scanner_root"
              name="Business Card Scanner"
              web_icon="business_card_scanner,static/description/icon.png"
              sequence="90"/>

    <!-- New Scan -->
    <menuitem id="menu_new_business_card_scan"
              name="New Scan"
              parent="menu_business_card_scanner_root"
              action="action_new_business_card_scan_server"
              sequence="5"/>

    <!-- All Scans -->
    <menuitem id="menu_business_card_scans"
              name="All Scans"
              parent="menu_business_card_scanner_root"
              action="action_business_card_scan_log"
              sequence="10"/>

    <!-- Card Scanner > Configuration (parent group, no action) -->
    <menuitem id="menu_business_card_config"
              name="Configuration"
              parent="menu_business_card_scanner_root"
              sequence="90"/>

    <!-- ================================================================
         Under Contacts → Configuration → Business Card App
    ================================================================ -->

    <!-- Section header (no action = renders as group label) -->
    <record id="menu_bc_section_header" model="ir.ui.menu">
        <field name="name">Business Card App</field>
        <field name="parent_id" search="[('name','=','Configuration'),('parent_id.name','=','Contacts')]"/>
        <field name="sequence">49</field>
    </record>

    <!-- Feed — points to Business Card Feed action -->
    <record id="menu_bc_feed_in_contacts" model="ir.ui.menu">
        <field name="name">Feed</field>
        <field name="action" ref="action_business_card_contacts"/>
        <field name="parent_id" ref="menu_bc_section_header"/>
        <field name="sequence">10</field>
    </record>

    <!--
        FIXED: Was incorrectly pointing to action_business_card_contacts (Feed).
        Now correctly points to action_business_card_template.
        This was the root cause of the unwanted Feed view appearing in the background.
    -->
    <record id="menu_bc_template_in_contacts" model="ir.ui.menu">
        <field name="name">Business Card Template</field>
        <field name="action" ref="action_business_card_template"/>
        <field name="parent_id" ref="menu_bc_section_header"/>
        <field name="sequence">20</field>
    </record>

</odoo>